//@version=6
indicator("v6 Functions - array/matrix/map E2E", overlay = true)

// ── array.* ───────────────────────────────────────────────────────────────────
var array<float> arr = array.new<float>(5, 0.0)
array.push(arr, close)
array.push(arr, open)
float arr_get    = array.get(arr, 0)
int   arr_size   = array.size(arr)
float arr_first  = array.first(arr)
float arr_last   = array.last(arr)
float arr_min    = array.min(arr)
float arr_max    = array.max(arr)
float arr_sum    = array.sum(arr)
float arr_avg    = array.avg(arr)
float arr_stdev  = array.stdev(arr)
float arr_med    = array.median(arr)
array.set(arr, 0, close)
array.insert(arr, 0, 99.0)
array.remove(arr, 0)
array.pop(arr)
array.shift(arr)
array.unshift(arr, 1.0)
array.clear(arr)
array.fill(arr, 0.0)
array.sort(arr, order.ascending)
array.reverse(arr)
array<float> arr2 = array.copy(arr)
array<float> arr3 = array.slice(arr, 0, 2)
array.concat(arr, arr2)
int arr_idx = array.indexof(arr, 0.0)
bool arr_inc = array.includes(arr, 0.0)
float arr_per = array.percentile_nearest_rank(arr, 90)
array<float> arr_from = array.from(1.0, 2.0, 3.0)

// ── matrix.* ─────────────────────────────────────────────────────────────────
var matrix<float> mat = matrix.new<float>(3, 3, 0.0)
matrix.set(mat, 0, 0, 1.0)
float mat_get = matrix.get(mat, 0, 0)
int mat_rows  = matrix.rows(mat)
int mat_cols  = matrix.columns(mat)
matrix<float> mat2  = matrix.copy(mat)
matrix<float> mat_tr = matrix.transpose(mat)
float mat_sum = matrix.sum(mat2)
matrix.add_row(mat, 0)
matrix.add_col(mat, 0)
matrix.remove_row(mat, 0)
matrix.remove_col(mat, 0)
array<float> mat_row = matrix.row(mat, 0)
array<float> mat_col = matrix.col(mat, 0)
float mat_avg  = matrix.avg(mat)
float mat_min  = matrix.min(mat)
float mat_max  = matrix.max(mat)
matrix.fill(mat, 1.0)
matrix.reverse(mat)

// ── map.* ─────────────────────────────────────────────────────────────────────
var map<string, float> m = map.new<string, float>()
map.put(m, "close", close)
float m_get    = map.get(m, "close")
bool  m_has    = map.contains(m, "close")
map.remove(m, "close")
int   m_size   = map.size(m)
array<string> m_keys = map.keys(m)
array<float>  m_vals = map.values(m)
map.clear(m)
map<string, float> m2 = map.copy(m)

plot(arr_avg, title="arr avg")
plot(mat_avg, title="mat avg")
