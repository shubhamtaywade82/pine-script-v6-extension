{
  "name": "pine-forge",
  "displayName": "PineForge — Pine Script v6 Language Server, Linter & Formatter",
  "description": "PineForge: Pine Script v6 language support — LSP diagnostics, hovers, filtered completions, go-to-reference (TradingView docs), find references, outline, workspace symbols, signature help, rename (user symbols), format document, and quick fixes. TradingView remains authoritative for full compiler parity.",
  "version": "0.2.0",
  "publisher": "shubhamtaywade82",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shubhamtaywade82/pine-forge"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "pine script",
    "pinescript",
    "tradingview",
    "linter",
    "language server",
    "pine v6",
    "formatter",
    "code actions",
    "LSP"
  ],
  "activationEvents": [
    "onLanguage:pinescript"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "pinescript",
        "aliases": [
          "Pine Script",
          "Pine Script v6",
          "PineScript"
        ],
        "extensions": [
          ".pine",
          ".pinescript"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pinescript",
        "scopeName": "source.pinescript",
        "path": "./syntaxes/pine.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "pineForge.openReference",
        "title": "Pine Script: Open v6 Reference Manual"
      }
    ],
    "configuration": {
      "title": "PineForge",
      "properties": {
        "pineForge.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable Pine Script v6 linting"
        },
        "pineForge.maxNumberOfProblems": {
          "type": "number",
          "default": 100,
          "description": "Maximum number of problems reported per file"
        },
        "pineForge.strictVersionCheck": {
          "type": "boolean",
          "default": true,
          "description": "Require //@version=6 annotation"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "scrape": "node dist/scraper/index.js",
    "watch": "tsc -w -p .",
    "test": "jest",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "jest": "^29.7.0",
    "puppeteer": "^24.42.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  }
}
