{
  "name": "pine-forge",
  "displayName": "PineForge — Pine Script v6 Language Server, Linter & Formatter",
  "description": "PineForge: Pine Script v6 language support — LSP diagnostics, hovers, filtered completions, go-to-reference (TradingView docs), find references, outline, workspace symbols, signature help, rename (user symbols), format document, and quick fixes. TradingView remains authoritative for full compiler parity.",
  "version": "0.2.3",
  "publisher": "shubhamtaywade82",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shubhamtaywade82/pine-forge"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "pine script",
    "pinescript",
    "tradingview",
    "linter",
    "language server",
    "pine v6",
    "formatter",
    "code actions",
    "LSP",
    "ollama",
    "AI"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "pinescript",
        "aliases": [
          "Pine Script",
          "Pine Script v6",
          "PineScript"
        ],
        "extensions": [
          ".pine",
          ".pinescript"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pinescript",
        "scopeName": "source.pinescript",
        "path": "./syntaxes/pine.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "pineForge.openReference",
        "title": "Pine Script: Open v6 Reference Manual"
      },
      {
        "command": "pineForge.ollama.explainSelection",
        "title": "PineForge: Explain selection with Ollama"
      },
      {
        "command": "pineForge.ollama.setApiKey",
        "title": "PineForge: Set Ollama API key (Secret Storage)"
      },
      {
        "command": "pineForge.ollama.clearApiKey",
        "title": "PineForge: Clear Ollama API key"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "pineForge.ollama.explainSelection",
          "when": "editorLangId == pinescript",
          "group": "pineForge@99"
        }
      ]
    },
    "configuration": {
      "title": "PineForge",
      "properties": {
        "pineForge.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable Pine Script v6 linting"
        },
        "pineForge.maxNumberOfProblems": {
          "type": "number",
          "default": 100,
          "description": "Maximum number of problems reported per file"
        },
        "pineForge.strictVersionCheck": {
          "type": "boolean",
          "default": true,
          "description": "Require //@version=6 annotation"
        },
        "pineForge.strictImplicitBoolIf": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, report bare `if close`-style series-as-bool on the same line only (conservative); skips strings/comments, comparisons, and indexing tails."
        },
        "pineForge.ollama.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable PineForge Ollama commands (sends editor selection to your configured Ollama host)."
        },
        "pineForge.ollama.host": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Ollama API base URL. Use https://ollama.com for Ollama Cloud (set API key via command)."
        },
        "pineForge.ollama.model": {
          "type": "string",
          "default": "",
          "description": "Model name for chat (e.g. llama3.1, or a cloud model id when using ollama.com)."
        },
        "pineForge.ollama.stream": {
          "type": "boolean",
          "default": true,
          "description": "Stream chat tokens to the PineForge AI output channel."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "scrape": "node dist/scraper/index.js",
    "watch": "tsc -w -p .",
    "test": "jest",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "dependencies": {
    "ollama": "^0.5.18",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.1",
    "jest": "^29.7.0",
    "puppeteer": "^24.42.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  }
}
