{
  "name": "pine-v6-linter",
  "displayName": "Pine Script v6 Linter",
  "description": "LSP-backed VS Code extension for Pine Script v6 — diagnostics, hover docs, autocomplete, and go-to-definition",
  "version": "0.1.0",
  "publisher": "shubhamtaywade82",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shubhamtaywade82/pine-v6-linter"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "pine script",
    "pinescript",
    "tradingview",
    "linter",
    "language server",
    "pine v6"
  ],
  "activationEvents": [
    "onLanguage:pinescript"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "pinescript",
        "aliases": [
          "Pine Script",
          "Pine Script v6",
          "PineScript"
        ],
        "extensions": [
          ".pine",
          ".pinescript"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pinescript",
        "scopeName": "source.pinescript",
        "path": "./syntaxes/pine.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "pineV6.openReference",
        "title": "Pine Script: Open v6 Reference Manual"
      }
    ],
    "configuration": {
      "title": "Pine Script v6 Linter",
      "properties": {
        "pineV6.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable Pine Script v6 linting"
        },
        "pineV6.maxNumberOfProblems": {
          "type": "number",
          "default": 100,
          "description": "Maximum number of problems reported per file"
        },
        "pineV6.strictVersionCheck": {
          "type": "boolean",
          "default": true,
          "description": "Require //@version=6 annotation"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "scrape": "node dist/scraper/index.js",
    "watch": "tsc -w -p .",
    "test": "jest",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "jest": "^29.7.0",
    "puppeteer": "^24.42.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  }
}
